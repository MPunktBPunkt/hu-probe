# Build / deps
.pio/
.venv/
venv/
__pycache__/
*.pyc
*.egg-info/
build/
.pytest_cache/
collector/.venv/
collector/*.egg-info/
collector/dist/

# IDE / OS
.idea/
.vscode/
*.swp
