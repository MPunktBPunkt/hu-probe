# Sessions (Messdaten lokal; ausgewählte Feld-/Lab-Sessions getrackt)
sessions/*
!sessions/.gitkeep
!sessions/20261014-081637_bmw_s0_plug_enum/
!sessions/20261014-081637_bmw_s0_plug_enum/**
